<odoo>
  <data noupdate="1"> <record id="rule_internal_message_employee" model="ir.rule">
      <field name="name">Message interne - Employé</field>
      <field name="model_id" ref="model_bamba_internal_message"/>
      <field name="domain_force">
        [('request_id.requester_id', '=', user.id)]
      </field>
      <field name="groups" eval="[(4, ref('bamba_base.group_bamba_employee'))]"/>
    </record>

    <record id="rule_internal_message_project_manager" model="ir.rule">
      <field name="name">Message interne - Chef de projet</field>
      <field name="model_id" ref="model_bamba_internal_message"/>
      <field name="domain_force">
        [('project_id.user_id', '=', user.id)] </field>
      <field name="groups" eval="[(4, ref('bamba_base.group_bamba_project_manager'))]"/>
    </record>

    <record id="rule_internal_message_manager" model="ir.rule">
      <field name="name">Message interne - Manager</field>
      <field name="model_id" ref="model_bamba_internal_message"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('bamba_base.group_bamba_manager'))]"/>
    </record>

  </data>
</odoo>
