<odoo>
  <data>

    <record id="module_category_bamba" model="ir.module.category">
      <field name="name">Bamba Corporation</field>
      <field name="sequence">30</field>
    </record>

    <record id="group_bamba_employee" model="res.groups">
      <field name="name">Bamba / Employé</field>
      <field name="category_id" ref="module_category_bamba"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bamba_project_manager" model="res.groups">
      <field name="name">Bamba / Chef de Projet</field>
      <field name="category_id" ref="module_category_bamba"/>
      <field name="implied_ids" eval="[(4, ref('group_bamba_employee'))]"/>
    </record>

    <record id="group_bamba_finance" model="res.groups">
      <field name="name">Bamba / Finance</field>
      <field name="category_id" ref="module_category_bamba"/>
      <field name="implied_ids" eval="[(4, ref('group_bamba_employee'))]"/>
    </record>

    <record id="group_bamba_manager" model="res.groups">
      <field name="name">Bamba / Manager</field>
      <field name="category_id" ref="module_category_bamba"/>
      <field name="implied_ids" eval="[
        (4, ref('group_bamba_project_manager')),
        (4, ref('group_bamba_finance'))
      ]"/>
    </record>

  </data>
</odoo>