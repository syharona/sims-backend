<odoo>
  <data>

    <!-- CHEF DE PROJET -->
    <record id="rule_project_project_manager" model="ir.rule">
      <field name="name">Projet - Chef de projet</field>
      <field name="model_id" ref="project.model_project_project"/>
      <field name="domain_force">
        [('project_manager_id', '=', user.id)]
      </field>
      <field name="groups" eval="[(4, ref('bamba_base.group_bamba_project_manager'))]"/>
    </record>

    <!-- MANAGER -->
    <record id="rule_project_manager_all" model="ir.rule">
      <field name="name">Projet - Manager</field>
      <field name="model_id" ref="project.model_project_project"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('bamba_base.group_bamba_manager'))]"/>
    </record>

  </data>
</odoo>
