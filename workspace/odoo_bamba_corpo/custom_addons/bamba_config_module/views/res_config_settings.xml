<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_bamba" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.bamba</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Demandes Bamba" id="bamba_request_settings" data-key="bamba_corporation_custom">
                    
                    <h2>Règles de Validation</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="manager_approval_threshold"/>
                                <div class="text-muted">
                                    Définir le seuil monétaire pour le niveau d'approbation Manager.
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="manager_approval_threshold" class="col-lg-5 o_light_label"/>
                                        <field name="manager_approval_threshold"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            
        </field>
    </record>
</odoo>
