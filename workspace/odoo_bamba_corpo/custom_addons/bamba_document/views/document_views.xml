<odoo>
  <record id="view_bamba_document_tree" model="ir.ui.view">
    <field name="name">bamba.document.list</field> <field name="model">bamba.document</field>
    <field name="type">list</field> <field name="arch" type="xml">
      <list> <field name="name"/>
        <field name="document_type"/>
        <field name="project_id"/>
        <field name="request_id"/>
        <field name="uploaded_by"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <record id="view_bamba_document_form" model="ir.ui.view">
    <field name="name">bamba.document.form</field>
    <field name="model">bamba.document</field>
    <field name="type">form</field> <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="document_type"/>
            <field name="file" filename="filename" widget="binary"/>
            <field name="filename" invisible="1"/>
          </group>
          <group>
            <field name="project_id"/>
            <field name="request_id"/>
          </group>
          <group>
            <field name="uploaded_by" readonly="1"/>
            <field name="create_date" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
