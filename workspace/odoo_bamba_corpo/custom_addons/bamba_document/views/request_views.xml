<odoo>
  <record id="view_bamba_request_form_documents" model="ir.ui.view">
    <field name="name">bamba.request.form.documents</field>
    <field name="model">bamba.request</field>
    <field name="inherit_id" ref="bamba_request.view_bamba_request_form"/>
    <field name="arch" type="xml">
      
      <xpath expr="//sheet" position="inside">
        <notebook>
          <page string="Documents">
            <field name="document_ids" context="{'default_request_id': id}">
              <list editable="bottom">
                <field name="name"/>
                <field name="document_type"/>
                <field name="file" widget="binary" filename="filename"/>
                <field name="filename" column_invisible="True"/>
                <field name="uploaded_by" readonly="1"/>
              </list>
            </field>
          </page>
        </notebook>
      </xpath>

    </field>
  </record>
</odoo>
